{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/capability-pack.schema.json",
  "title": "Rainy Capability Pack",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "exports"],
  "properties": {
    "apiVersion": { "const": "rainy.dev/v1" },
    "kind": { "const": "CapabilityPack" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "skillsPackage"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
              "source": { "type": "string", "minLength": 1 },
              "skillsPackage": { "type": "string", "pattern": "^skills@[^@*^~]+$" },
              "allowPrivateHttp": { "type": "boolean", "default": false },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "extensions": { "type": "object" }
  },
  "patternProperties": { "^x-[A-Za-z0-9._-]+$": true },
  "additionalProperties": false
}
