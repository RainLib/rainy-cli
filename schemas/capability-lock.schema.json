{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/capability-lock.schema.json",
  "title": "Rainy Capability Lock",
  "type": "object",
  "required": ["lockfileVersion", "project", "rainy", "capabilities"],
  "properties": {
    "lockfileVersion": { "enum": [1, 2] },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rainy": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "pack", "installedAt", "artifacts"],
        "properties": {
          "version": { "type": "string" },
          "provider": { "type": ["string", "null"] },
          "pack": { "type": "string" },
          "source": { "type": "string" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "installedAt": { "type": "string", "format": "date-time" },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "managedChanges": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["actionId", "kind", "path", "marker"],
                  "properties": {
                    "actionId": { "type": "string" },
                    "kind": { "const": "jvm-managed-block" },
                    "path": { "type": "string" },
                    "marker": { "type": "string", "pattern": "^rainy-managed:" },
                    "expectedValueSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "provider": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["actionId", "kind", "path", "marker", "expectedValueSha256"],
                  "properties": {
                    "actionId": { "type": "string" },
                    "kind": { "const": "yaml-semantic-path" },
                    "path": { "type": "string" },
                    "marker": { "type": "string", "pattern": "^/" },
                    "expectedValueSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "provider": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
