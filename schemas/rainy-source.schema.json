{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/rainy-source.schema.json",
  "title": "Rainy Self-Describing Source",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "requires", "contents"],
  "properties": {
    "apiVersion": { "const": "rainy.dev/v1" },
    "kind": { "const": "RainySource" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": ["rainy"],
      "properties": {
        "rainy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "type": {
            "enum": ["project-template-catalog", "project-template", "workspace-module", "capability-pack", "skill", "plugin", "defaults"]
          },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "defaultTarget": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "type": "object" }
  },
  "patternProperties": { "^x-[A-Za-z0-9._-]+$": true },
  "additionalProperties": false
}
