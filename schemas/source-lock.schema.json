{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/source-lock.schema.json",
  "title": "Rainy User Source Lock",
  "type": "object",
  "required": ["lockfileVersion", "sources"],
  "properties": {
    "lockfileVersion": { "const": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sourceType", "source", "resolvedRef", "version", "digest", "cachePath", "contents", "syncedAt"],
        "properties": {
          "sourceType": { "enum": ["local", "git", "archive", "index"] },
          "source": { "type": "string", "minLength": 1 },
          "requestedRef": { "type": "string" },
          "resolvedRef": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "cachePath": { "type": "string", "minLength": 1 },
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "path", "digest"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "version": { "type": ["string", "null"] },
                "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "syncedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
