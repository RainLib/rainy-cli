{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/project-source-lock.schema.json",
  "title": "Rainy Generated Project Source Lock",
  "type": "object",
  "required": ["lockfileVersion", "source", "template", "modules", "createdAt"],
  "properties": {
    "lockfileVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["name", "version", "resolvedRef", "digest", "origin"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "resolvedRef": { "type": "string" },
        "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "origin": {
          "type": "object",
          "required": ["source", "channel"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
            "channel": { "type": "string", "minLength": 1 },
            "selectedVersion": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "template": { "type": "string" },
    "modules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
