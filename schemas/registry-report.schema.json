{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/registry-report.schema.json",
  "title": "Rainy Registry Report",
  "type": "object",
  "required": ["protocolVersion", "status", "operation", "registries", "checks"],
  "properties": {
    "protocolVersion": { "const": "rainy.registry-report.v1" },
    "status": { "enum": ["dry-run", "applied", "passed", "failed"] },
    "operation": { "enum": ["list", "add", "install", "sync", "update", "remove", "doctor"] },
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sourceType", "source", "priority", "modules", "installedSkills", "synced"],
        "properties": {
          "name": { "type": "string" },
          "sourceType": { "type": "string" },
          "source": { "type": "string" },
          "priority": { "type": "integer" },
          "requestedRef": { "type": ["string", "null"] },
          "resolvedRef": { "type": ["string", "null"] },
          "digest": { "type": ["string", "null"] },
          "cachePath": { "type": ["string", "null"] },
          "modules": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "installedSkills": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "synced": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "warning", "failed"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
