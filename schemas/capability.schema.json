{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/capability.schema.json",
  "title": "Rainy Capability",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "name", "version", "actions"],
  "properties": {
    "apiVersion": { "const": "rainy.dev/v1" },
    "kind": { "const": "Capability" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "default": { "type": "boolean" },
          "requiredConfig": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "object",
      "properties": {
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "uses"],
            "properties": {
              "id": { "type": "string" },
              "uses": { "type": "string" },
              "with": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "run": {
            "type": "object",
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "command": { "type": "string", "minLength": 1 },
          "workingDirectory": { "type": "string" },
          "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "platforms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "oneOf": [
          { "required": ["run"], "not": { "required": ["command"] } },
          { "required": ["command"], "not": { "required": ["run"] } }
        ],
        "additionalProperties": false
      }
    },
    "doctor": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "uses"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "uses": { "type": "string", "minLength": 1 },
              "with": true
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agentRules": { "type": "array", "items": { "type": "string" } },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "default": true
        },
        "additionalProperties": false
      }
    },
    "status": { "type": "string" },
    "owner": { "type": "string" },
    "extensions": { "type": "object" },
    "policy": {
      "type": "object",
      "properties": {
        "allowEdit": {
          "type": "array",
          "items": { "type": "string" }
        },
        "denyEdit": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requireApproval": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": { "^x-[A-Za-z0-9._-]+$": true },
  "additionalProperties": false
}
