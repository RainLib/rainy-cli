{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/project-template-catalog.schema.json",
  "title": "Rainy Project Template Catalog",
  "type": "object",
  "required": ["apiVersion", "kind", "templates"],
  "properties": {
    "apiVersion": { "const": "rainy.dev/v1" },
    "kind": { "const": "ProjectTemplateCatalog" },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "description": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": { "const": "git" },
              "url": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "defaultRemote": { "type": "string", "minLength": 1 },
              "allowInsecureHttp": { "type": "boolean", "default": false },
              "remotes": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "description": { "type": "string" },
                    "url": { "type": "string", "minLength": 1 },
                    "allowInsecureHttp": { "type": "boolean", "default": false }
                  },
                  "additionalProperties": false
                }
              }
            },
            "oneOf": [
              {
                "required": ["url"],
                "not": { "required": ["remotes"] }
              },
              {
                "required": ["remotes"],
                "not": { "required": ["url"] }
              }
            ],
            "additionalProperties": false
          },
          "subdirectory": { "type": "string", "minLength": 1 },
          "overlay": { "type": "string", "minLength": 1 },
          "textReplacements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "find", "replace"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "find": { "type": "string", "minLength": 1, "maxLength": 65536 },
                "replace": { "type": "string", "maxLength": 65536 },
                "expectedMatches": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 1
                }
              },
              "additionalProperties": false
            }
          },
          "repository": {
            "type": "object",
            "properties": {
              "defaultBranch": { "type": "string", "minLength": 1, "default": "main" },
              "remoteUrl": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
