{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainy.dev/schemas/rainy-source-index.schema.json",
  "title": "Rainy Source Release Index",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "releases"],
  "properties": {
    "apiVersion": { "const": "rainy.dev/v1" },
    "kind": { "const": "RainySourceIndex" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }
      },
      "additionalProperties": false
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "url", "sha256"],
        "properties": {
          "version": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "channel": { "type": "string", "minLength": 1, "default": "stable" },
          "notesUrl": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "type": "object" }
  },
  "patternProperties": { "^x-[A-Za-z0-9._-]+$": true },
  "additionalProperties": false
}
